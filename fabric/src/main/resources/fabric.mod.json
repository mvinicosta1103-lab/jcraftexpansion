{
  "schemaVersion": 1,
  "id": "jcraft_expansion",
  "version": "${version}",
  "name": "JCraft - Expansion",
  "description": "An addon for JCraft that expands the mod with new content.",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/jcraft_expansion/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.jcraftexpansion.fabric.JCraftExpansionFabric"
    ],
    "client": [
      "com.jcraftexpansion.fabric.client.JCraftExpansionFabricClient"
    ],
    "fabric-datagen": [
      "com.jcraftexpansion.fabric.datagen.JCraftExpansionDataGen"
    ]
  },
  "mixins": [
    "jcraft_expansion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "jcraft": ">=0.18.0"
  }
}
